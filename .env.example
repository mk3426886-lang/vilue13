# Vilue — environment variables (copy to .env, never commit .env)

# --- Server ---
NODE_ENV=development
PORT=4000
APP_BASE_URL=http://localhost:4000

# --- Database: Supabase (PostgreSQL) ---
# From your Supabase project: Project Settings -> API
# SUPABASE_SERVICE_ROLE_KEY is secret — backend only, never send to the frontend.
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_ANON_KEY=

# --- Auth ---
JWT_SECRET=change_me
JWT_EXPIRES_IN=7d
SESSION_SECRET=change_me

# --- Verification codes ---
OTP_LENGTH=6
OTP_TTL_MINUTES=10
OTP_MAX_PER_15_MIN=5
OTP_RESEND_COOLDOWN_SECONDS=30

# --- Email provider: Gmail via Nodemailer ---
# GMAIL_APP_PASSWORD is a 16-character Google "App Password", generated at
# https://myaccount.google.com/apppasswords (requires 2-Step Verification
# enabled on the Gmail account). It is NOT the normal Gmail password.
EMAIL_PROVIDER=gmail
GMAIL_USER=your.vilue.address@gmail.com
GMAIL_APP_PASSWORD=

# --- WhatsApp provider (DEFERRED — phone verification is not part of the
# MVP; registration is email-only for now. Fill this in when phone/WhatsApp
# is enabled in a later stage.) ---
# Official WhatsApp Business Cloud API (Meta) — business.facebook.com
SMS_PROVIDER=whatsapp_cloud_api
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_API_VERSION=v20.0

# --- Payments (placeholders until real integrations are configured) ---
MASTERCARD_GATEWAY_KEY=
ZAINCASH_MERCHANT_ID=
ZAINCASH_SECRET=

# --- Exchange rates (also editable live from the admin panel) ---
RATE_USDT_TO_IQD=1320
RATE_IQD_TO_SLON=5

